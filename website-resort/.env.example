# SiteMinder Direct Booking API — server-side only, never expose to the client.
# Generate/find these in the Multi-Property Platform under Direct Booking → API.
SITEMINDER_API_KEY=
SITEMINDER_PROPERTY_ID=

# Resend — sends the contact form to the resort inbox (api/contact.ts). The
# same key lets `npm run email:publish` upload emails/contact-enquiry.html.
RESEND_API_KEY=
RESEND_CONTACT_ENQUIRY_TEMPLATE_ID=contact-enquiry
RESEND_CONTACT_CONFIRMATION_TEMPLATE_ID=contact-confirmation
CONTACT_FROM=Hula Hula Resort <reservation@hulahularesort.com>
CONTACT_TO=reservation@hulahularesort.com
CONTACT_BCC=contact@bluetrendy.com

# Public site address — where Stripe sends guests back to and the links in the
# booking emails point. Required in production (e.g. https://hulahularesort.com).
SITE_URL=

# ── On-site booking ────────────────────────────────────────────────────────
# "true" sends "Check availability" to /book instead of SiteMinder's own
# booking engine. Leave off until Stripe and Supabase below are configured.
VITE_ONSITE_BOOKING=false

# Stripe Checkout — server-side restricted key (rk_; test keys charge nothing).
# The key needs Checkout Sessions write, PaymentIntents, Charges and Events read.
# Its publishable key (pk_) shows Stripe's form inside our payment step.
# Existing 2C2P bookings still use their original gateway for status checks;
# retain TWOC2P_* settings on deployments that share those bookings.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Supabase (project geivjvgpntdwxwkfriai): CMS content + short-lived bookings.
# Keys: Dashboard → Project Settings → API Keys. The secret (service role) key
# is server-side only; the anon/publishable key is safe in the browser.
# Never put a personal access token (sbp_…) here.
SUPABASE_URL=https://geivjvgpntdwxwkfriai.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=https://geivjvgpntdwxwkfriai.supabase.co
VITE_SUPABASE_ANON_KEY=

# Booking emails (Resend templates in emails/, published by `npm run email:publish`).
RESEND_BOOKING_NOTIFICATION_TEMPLATE_ID=booking-notification
RESEND_BOOKING_CONFIRMATION_TEMPLATE_ID=booking-confirmation
# Who gets "ACTION: enter in SiteMinder" emails (defaults to CONTACT_TO / CONTACT_BCC / CONTACT_FROM).
BOOKING_ADMIN_TO=reservation@hulahularesort.com
BOOKING_ADMIN_BCC=contact@bluetrendy.com
BOOKING_FROM=Hula Hula Resort <reservation@hulahularesort.com>

# Vercel Cron sends this as a bearer token to /api/cron/reconcile (any long random string).
CRON_SECRET=

# Tuning (optional): minutes a room is held while the guest pays, rooms per
# online booking, what to charge when a SiteMinder rate has no deposit set
# ("full" or "first-night"). Paid bookings are always emailed to reservations
# for manual entry in SiteMinder.
BOOKING_HOLD_MINUTES=30
BOOKING_MAX_ROOMS=5
BOOKING_DEFAULT_DEPOSIT=full
