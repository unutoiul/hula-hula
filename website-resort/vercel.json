{
  "regions": ["sin1"],
  "rewrites": [
    { "source": "/book", "destination": "/book.html" },
    { "source": "/book/", "destination": "/book.html" },
    { "source": "/((?!api/|@|src/|node_modules/)[^.]*)", "destination": "/" }
  ],
  "headers": [
    { "source": "/admin(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] },
    { "source": "/book/details(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] },
    { "source": "/book/payment(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] },
    { "source": "/book/confirmation(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] },
    { "source": "/api/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ],
  "crons": [{ "path": "/api/cron/reconcile", "schedule": "0 20 * * *" }]
}
